  "protocol": "mlmsync",
  "version": 1,
  "kdf": "PBKDF2-HMAC-SHA256",
  "iterations": 100000,
  "saltBytes": 16,
  "cipher": "AES-256-GCM",
  "ivBytes": 12,
  "tagBytes": 16,
  "uriPrefix": "mlmsync://v1/",
  "binaryLayout": "salt(16) || iv(12) || ciphertext(N) || authTag(16)",
  "aad": "mlmvpn-sovereign-sync-v1",
  "sections": [
    "cfBypass",
    "cloudAccounts",
    "cloudWorkers",
    "v2rayNodes",
    "subscriptions",
    "cleanIps",
    "sanctionRules",
    "githubTunnel",
    "gstRelays",
    "vodiGateways",
    "extendedVpns"
  ]
}
